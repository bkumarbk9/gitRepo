<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BK_CloudSpreadsheet</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Container image, built by the .NET SDK (dotnet publish -t:PublishContainer); no Dockerfile -->
    <ContainerRepository>cloudspreadsheet</ContainerRepository>
    <ContainerFamily>noble-chiseled</ContainerFamily>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sample sheets offered the first time a sheet with the same name is opened -->
    <Content Include="SampleSheets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudSpreadsheet.Tests" />
  </ItemGroup>

</Project>
