{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Deployment": {
    "Profile": "azure"
  },
  "Feed": {
    "Mode": "shared",
    "EndOfDay": "23:59",
