<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BK_AzDocIntelligenceAI</RootNamespace>
    <UserSecretsId>9db1c136-2739-469a-9381-e24e1353a7e4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <!-- Angular client: built on publish and served from wwwroot (works for VS Publish / dotnet publish,
       including the .NET SDK container publish). Pass BuildClient=false to skip it. -->
  <PropertyGroup>
    <ClientRoot>$(MSBuildProjectDirectory)\..\AzDocIntelligenceAI.Client\document-extractor\</ClientRoot>
    <BuildClient Condition="'$(BuildClient)' == ''">true</BuildClient>
  </PropertyGroup>

  <Target Name="PublishAngularClient" AfterTargets="ComputeFilesToPublish" Condition="'$(BuildClient)' == 'true'">
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm ci" Condition="!Exists('$(ClientRoot)node_modules')" />
    <Exec WorkingDirectory="$(ClientRoot)" Command="npx ng build --configuration production" />
    <ItemGroup>
      <ClientDistFiles Include="$(ClientRoot)dist\document-extractor\browser\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
